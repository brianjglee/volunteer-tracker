}

// Week number where Week 1 = first Sunday of the year
function weekNumberSundayStart_(date) {
  const y = date.getFullYear();

  // first Sunday ON/AFTER Jan 1 (same rule as your original)
  const jan1 = new Date(y, 0, 1);
  const firstSunday = new Date(y, 0, 1 + ((7 - jan1.getDay()) % 7));

  // Use UTC midnight for both dates so DST can't change the math
  const utcDate = Date.UTC(date.getFullYear(), date.getMonth(), date.getDate());
  const utcFirstSunday = Date.UTC(firstSunday.getFullYear(), firstSunday.getMonth(), firstSunday.getDate());

  const diffDays = Math.floor((utcDate - utcFirstSunday) / 86400000);
  return diffDays < 0 ? 1 : Math.floor(diffDays / 7) + 1;
}

