/**
 * Find and download the morning/evening .docx from the Notion service page for a given date.
 * Looser matching:
 *   - morning = any file name ending in "-morning.docx"
 *   - evening = any file name ending in "-evening.docx"
 * Preference:
 *   - If multiple matches exist, prefer the one that also contains the ISO date (YYYY-MM-DD).
 *
 * Returns: { morning: Blob|null, evening: Blob|null }
 */
function getServiceDocxAttachmentsForDate_(dateLike) {
  if (!NOTION.ENABLED) return { morning: null, evening: null };

  const iso = toIsoDate_(dateLike); // YYYY-MM-DD
  const morningSuffix = '-morning.docx';
  const eveningSuffix = '-evening.docx';

  const rows = queryRowsByDate_(iso);
  if (!rows || !rows.length) return { morning: null, evening: null };

  let morningBlob = null;
  let eveningBlob = null;

  // Track best candidates (prefer names containing the iso date)
  let morningBest = null; // {url,name,score}
  let eveningBest = null;

  for (const row of rows) {
    const pageId = (row.id || '').replace(/-/g, '');
    if (!pageId) continue;

    const fileBlocks = findFileBlocksRecursive_(pageId);

    for (const blk of fileBlocks) {
      const info = getNotionFileBlockInfo_(blk); // {name,url} or null
      if (!info || !info.url) continue;

      const name = String(info.name || '').trim();
      if (!name) continue;

      const nameLower = name.toLowerCase();

      // Score: +10 if contains iso date, +1 if suffix match (so suffix match required anyway)
      const containsIso = nameLower.includes(iso.toLowerCase());
      const score = (containsIso ? 10 : 0) + 1;

      if (nameLower.endsWith(morningSuffix)) {
        if (!morningBest || score > morningBest.score) {
          morningBest = { url: info.url, name: name, score: score };
        }
      }

      if (nameLower.endsWith(eveningSuffix)) {
        if (!eveningBest || score > eveningBest.score) {
          eveningBest = { url: info.url, name: name, score: score };
        }
      }
    }

    // If we found both best candidates on this page, no need to scan other date-matching pages
    if (morningBest && eveningBest) break;
  }

  // Download best matches (if any)
  if (morningBest) {
    morningBlob = downloadToBlob_(morningBest.url, morningBest.name);
  }
  if (eveningBest) {
    eveningBlob = downloadToBlob_(eveningBest.url, eveningBest.name);
  }

  return { morning: morningBlob, evening: eveningBlob };
}

/**
 * Recursively finds all "file" blocks under a Notion block/page (handles pagination).
 * Returns an array of block objects.
 */
function findFileBlocksRecursive_(rootBlockId) {
  const out = [];
  const queue = [rootBlockId];

  while (queue.length) {
    const blockId = queue.shift();
    const children = fetchAllNotionChildren_(blockId);

    for (const blk of children) {
      if (blk && blk.type === 'file') out.push(blk);
      // If it has children, recurse
      if (blk && blk.has_children && blk.id) {
        queue.push(String(blk.id).replace(/-/g, ''));
      }
    }
  }
  return out;
}

/**
 * Fetch all children blocks for a given blockId with pagination.
 */
function fetchAllNotionChildren_(blockId) {
  const results = [];
  let cursor = null;

  while (true) {
    let url = `https://api.notion.com/v1/blocks/${blockId}/children?page_size=100`;
    if (cursor) url += `&start_cursor=${encodeURIComponent(cursor)}`;

    const resp = UrlFetchApp.fetch(url, { headers: notionHeaders_(), muteHttpExceptions: true });
    if (resp.getResponseCode() !== 200) break;

    const json = JSON.parse(resp.getContentText());
    const batch = json.results || [];
    results.push(...batch);

    if (!json.has_more || !json.next_cursor) break;
    cursor = json.next_cursor;
  }

  return results;
}

/**
 * Extract a filename + downloadable URL from a Notion "file" block.
 * Attempts to use official fields, with a fallback to parsing from the URL.
 */
function getNotionFileBlockInfo_(fileBlock) {
  if (!fileBlock || fileBlock.type !== 'file' || !fileBlock.file) return null;

  const f = fileBlock.file;
  let url = '';
  if (f.type === 'file' && f.file && f.file.url) url = f.file.url;
  if (f.type === 'external' && f.external && f.external.url) url = f.external.url;

  // Notion usually returns a "name" for file blocks; if missing, infer from url path
  let name = f.name || '';
  if (!name && url) {
    const m = url.split('?')[0].match(/\/([^\/?#]+)$/);
    name = m ? decodeURIComponent(m[1]) : '';
  }

  return { name: name || '', url: url || '' };
}

/**
 * Downloads a URL to a Gmail-compatible Blob, sets a filename.
 */
function downloadToBlob_(url, filename) {
  try {
    const resp = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
    if (resp.getResponseCode() !== 200) return null;

    const blob = resp.getBlob();
    blob.setName(filename);

    // (Optional) set the docx content type explicitly
    // Gmail doesn't require this, but it's nice to be explicit.
    blob.setContentType('application/vnd.openxmlformats-officedocument.wordprocessingml.document');

    return blob;
  } catch (e) {
    return null;
  }
}

/**
 * Decide which attachment a person should get.
 * Evening people get evening doc; everyone else gets morning doc.
 */
function getServiceTypeForPerson_(msg) {
  return !!(msg && (msg.isEveningMusic || msg.isEveningPreach || msg.isEveningLead))
    ? 'evening'
    : 'morning';
}

function pickServiceDocxForPerson_(attachmentsObj, msg) {
  if (!attachmentsObj) return null;
  const serviceType = getServiceTypeForPerson_(msg);
  return serviceType === 'evening' ? attachmentsObj.evening : attachmentsObj.morning;
}

// ---------- Sermon formatting (indent + remove lines) ----------
function formatSermonForEmail_(raw) {
  if (!raw) return { text: '', html: '' };

  // Normalize newlines
  const lines = String(raw).replace(/\r\n/g, '\n').replace(/\r/g, '\n').split('\n');

  // Remove meta JSON blob if it exists at the end (optional but recommended)
  // (looks for a line starting with {"inputs": ...} and removes everything after it)
  const jsonStart = lines.findIndex(l => /^\s*\{\s*"inputs"\s*:/.test(l));
  const cleanedLines = (jsonStart >= 0) ? lines.slice(0, jsonStart) : lines.slice();

  // Remove specific top-level lines anywhere
  const filtered = cleanedLines.filter(l => {
    const t = l.trim();
    if (/^Sermon Text:\s*/i.test(t)) return false;
    if (/^Sermon Title:\s*/i.test(t)) return false;
    return true;
  });

  const indent1 = '        ';   // 8 SPACES
  const indent2 = '                '; // 16 SPACES

  const INDENT1_PREFIXES = [
    'Call to Worship:',
    'Prayer of Praise',
    'Giving Passage:',
    'Pastoral Prayer',
    "Lord's Supper",
    'Evening Passage:',
    'Sermon' // exact "Sermon" line should be indented
  ];

  const isSectionHeader = (t) =>
    t === '' ||
    /^Sunday Service\s+—/i.test(t) ||
    /^Morning Preacher:/i.test(t) ||
    /^Morning Service$/i.test(t) ||
    /^Evening Service$/i.test(t);

  const startsWithAny = (t, arr) => arr.some(p => t.startsWith(p));

  let prevTrim = '';
  let inSermonBlock = false;

  const out = [];

  for (let i = 0; i < filtered.length; i++) {
    const line = filtered[i];
    const t = line.trim();

    if (!t) { // keep blank lines
      out.push('');
      prevTrim = '';
      continue;
    }

    // Toggle sermon block state: after indented "Sermon", indent next lines x2 until Lord's Supper
    if (t === 'Sermon') inSermonBlock = true;
    if (t.startsWith("Lord's Supper")) inSermonBlock = false;

    // Bullet lines => indent x2
    if (t.startsWith('•')) {
      out.push(indent2 + t);
      prevTrim = t;
      continue;
    }

    // The text line right after Call to Worship / Giving Passage / Evening Passage => indent x1
    const prevIsCall = prevTrim.startsWith('Call to Worship:');
    const prevIsGiving = prevTrim.startsWith('Giving Passage:');
    const prevIsEveningPassage = prevTrim.startsWith('Evening Passage:');
    if (prevIsCall || prevIsGiving || prevIsEveningPassage) {
      out.push(indent1 + t);
      prevTrim = t;
      continue;
    }

    // Inside sermon details (passage + Title lines) => indent x2
    // (but don't indent if it's a section header)
    if (inSermonBlock && !isSectionHeader(t) && t !== 'Sermon' && !t.startsWith("Lord's Supper")) {
      out.push(indent2 + t);
      prevTrim = t;
      continue;
    }

    // Indent certain labels x1 (Call to Worship label itself, etc.)
    if (startsWithAny(t, INDENT1_PREFIXES)) {
      out.push(indent1 + t);
      prevTrim = t;
      continue;
    }

    // Default: keep as-is
    out.push(t);
    prevTrim = t;
  }

  const sermonText = out.join('\n').trim();

  // HTML version: bold header + indent that survives wrapping
  const headerHtml = `<b>Notes for this Sunday:</b>`;

  // Make these bigger/smaller to control indent depth in HTML:
  const INDENT1_PX = 28;  // [INDENT]
  const INDENT2_PX = 56;  // [INDENT x2]

  // Turn the already-indented plain text into per-line HTML with margins.
  // (We look at leading spaces to decide which margin to apply.)
  const htmlLines = sermonText.split('\n').map(line => {
    const leadingSpaces = (line.match(/^ */) || [''])[0].length;
    const trimmed = line.replace(/^ */, '');

    let margin = 0;
    if (leadingSpaces >= indent2.length) margin = INDENT2_PX;
    else if (leadingSpaces >= indent1.length) margin = INDENT1_PX;

    // Preserve blank lines
    if (!trimmed) return `<div style="height:0.6em;"></div>`;

    return `<div style="margin-left:${margin}px;">${escapeHtml_(trimmed)}</div>`;
  }).join('');

  const sermonHtml = `${headerHtml}<div style="margin-top:6px;">${htmlLines}</div>`;

  return { text: sermonText, html: sermonHtml };
}

// Basic HTML escaping for <pre> content
function escapeHtml_(s) {
  return String(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

function getVolunteerServiceProfile_(msg) {
  const servesMorning =
    !!(
      msg.isCounter ||
      msg.isAV ||
      msg.isMorningMusician ||
      msg.isMorningLead ||
      msg.isGuestPreach ||
      msg.isCounterBackup ||
      msg.isAVBackup
    );

  const servesEvening =
    !!(
      msg.isEveningLead ||
      msg.isEveningMusic ||
      msg.isEveningPreach
    );

  return {
    morning: servesMorning,
    evening: servesEvening
  };
}

function getAttachmentsForVolunteer_(attachmentsObj, serviceProfile) {
  if (!attachmentsObj) return [];

  const out = [];
  if (serviceProfile.morning && attachmentsObj.morning) out.push(attachmentsObj.morning);
  if (serviceProfile.evening && attachmentsObj.evening) out.push(attachmentsObj.evening);
  return out;
}

function buildNotesTextForVolunteer_(serviceProfile, notesByService) {
  const pieces = [];

  if (serviceProfile.morning && notesByService.morning.text) {
    pieces.push(notesByService.morning.text.trim());
  }

  if (serviceProfile.evening && notesByService.evening.text) {
    const eveningText = notesByService.evening.text.trim();
    const alreadyAddedMorning =
      serviceProfile.morning &&
      notesByService.morning.text &&
      notesByService.morning.text.trim() === eveningText;

    if (!alreadyAddedMorning) {
      pieces.push(eveningText);
    }
  }

  if (!pieces.length) return '';
  return '\n' + pieces.join('\n\n') + '\n';
}

function buildNotesHtmlForVolunteer_(serviceProfile, notesByService) {
  const pieces = [];

  if (serviceProfile.morning && notesByService.morning.html) {
    pieces.push(notesByService.morning.html);
  }

  if (serviceProfile.evening && notesByService.evening.html) {
    const eveningHtml = notesByService.evening.html;
    const alreadyAddedMorning =
      serviceProfile.morning &&
      notesByService.morning.html &&
      notesByService.morning.html === eveningHtml;

    if (!alreadyAddedMorning) {
      pieces.push(eveningHtml);
    }
  }

  return pieces.join('<br><br>');
}

function buildHtmlBodyWithoutDuplicateNotes_(plainBody, notesHtml) {
  let htmlBody = escapeHtml_(plainBody).replace(/\n/g, '<br>');

  // remove the plain-text "Notes for this Sunday:" block from the HTML rendering
  // so we don't show both the escaped plain notes and the formatted HTML notes
  const marker = 'Notes for this Sunday:<br>';
  const idx = htmlBody.indexOf(marker);

  if (idx >= 0) {
    htmlBody = htmlBody.substring(0, idx);
  }

  if (notesHtml) {
    htmlBody += '<br><br>' + notesHtml;
  }

  return htmlBody;
}
