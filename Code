/*******************************
 * Code.gs
 * Volunteer Reminder Automations
 * UPDATE NOTION DB_ID 
 * Sheets:
 *  - "volunteers": ID, FirstName, LastName, Email, PhoneNumber, Counting, Music, AV, ServiceCounter
 *  - "2025": Week, Counting1, Counting2, Counting3, Music1..Music5, AV1..AV3
 * Assumptions:
 *  - "Week" = week index (1..52/53) where Week 1 = first Sunday of that year.
 *  - Schedule cells contain volunteer IDs that match the "volunteers" sheet. 
 *******************************/

const CONFIG = {
  VOL_SHEET: 'volunteers',
  SCHED_SHEET: '2025',         // change to the year tab you are using
  TIMEZONE: 'America/Los_Angeles',
  WEEKLY_SEND_HOUR: 9,         // 9am PT Thursday ***********************************************************************
  FROM_NAME: 'Brian Lee',
  UPDATE_SERVICE_COUNTER: true, // set false if you don't want counters updated
  TEST_MODE: false,
  NOTION_TEAM_SYNC_ENABLED: true,   // set false to disable write-back
  NOTION_TEAM_SYNC_SKIP_EMPTY: true // don't wipe Notion with blanks
};

// --- Notion config ---
const NOTION = {
  ENABLED: true,
  API_VERSION: '2022-06-28',
  DB_ID: '###', // your database id
  DATE_PROP: 'Date',        // the Notion "date" property name in the DB
  MAX_CHARS: 10000,           // optional truncate for email
  PREACHER_NAME_PROP: 'Preacher',
  GUEST_EMAIL_PROP: "Guest Preachers' Email",
  EVENING_PREACHER_NAME_PROP: 'Evening Preacher',
  EVENING_PREACHER_EMAIL_PROP: "Evening Preacher's Email",
  EVENING_PASSAGE_PROP: 'Evening Passage',
  TEAM_MORNING_MUSIC_PROP: 'Morning Music',
  TEAM_COUNTING_PROP: 'Counting',
  TEAM_AV_PROP: 'Audio/Visual',
  TEAM_EVENING_MUSIC_PROP: 'Evening Music',
  SERVICE_LEADER_PROP: 'Service Leader'
};

// Column groups in the schedule tab
// NOTE: Counting3 and AV3 are BACKUPS, not primaries.
const COLS = {
  COUNTING_PRIMARIES: ['Counting1', 'Counting2'],
  COUNTING_BACKUP: 'Counting3',
  MUSIC: ['Music1', 'Music2', 'Music3', 'Music4', 'Music5'],
  AV_PRIMARIES: ['AV1', 'AV2'],
  AV_BACKUP: 'AV3',
  MORNING_LEAD: 'MorningLead',
  EVENING_LEAD: 'EveningLead',
  EVENING_MUSIC: 'EveningMusic',
  EVENING_PREACH: 'EveningPreach',
  GUEST_PREACH: 'GuestPreach'
};



// ========== PUBLIC: one-time trigger setup ==========
function createTriggers() {
  deleteAllTriggers_(); // keep using your existing helper

  // One Thursday trigger at your chosen hour (uses CONFIG.WEEKLY_SEND_HOUR)
  ScriptApp.newTrigger('sendThursdayReminders')
    .timeBased()
    .onWeekDay(ScriptApp.WeekDay.THURSDAY)
    .atHour(CONFIG.WEEKLY_SEND_HOUR)   // e.g., 9 for 9am PT
    .create();
}

// (Helper) delete all existing project triggers
function deleteAllTriggers_() {
  ScriptApp.getProjectTriggers().forEach(t => ScriptApp.deleteTrigger(t));
}

function sendThursdayReminders() {
  const now = new Date();

  // Always send the weekly reminder for the coming Sunday
  sendWeeklyReminders();

  // If it's the first Thursday (day 1–7), also send the monthly email
  if (isFirstThursday_(now)) {
    sendMonthlyReminders();
    sendGuestPreacherMonthlyReminders();

    // ===== ADDED: monthly evening preacher aggregator =====
    sendEveningPreacherMonthlyReminders();
  }
  if (CONFIG.NOTION_TEAM_SYNC_ENABLED) {
    try {
      syncNotionTeamsNext4Weeks();
    } catch (e) {
      notifyTeamSyncFailure_(e);
    }
  }
}

function isFirstThursday_(d) {
  // Thursday is 4 (Sun=0, Mon=1, Tue=2). First Thursday falls on the 1st–7th.
  return d.getDay() === 4 && d.getDate() <= 7;
}

function sendWeeklyReminders() {
  const tz = CONFIG.TIMEZONE;
  const now = new Date();
  const nextSunday = getNextSunday_(now);
  const scheduleSheet = getScheduleSheetForDate_(nextSunday);
  const weekNum = weekNumberSundayStart_(nextSunday);
  const sched = readScheduleRowByWeek_(scheduleSheet, weekNum);
  const serviceDocx = getServiceDocxAttachmentsForDate_(nextSunday); // { morning, evening }

  const hasMorningDoc = !!(serviceDocx && serviceDocx.morning);
  const hasEveningDoc = !!(serviceDocx && serviceDocx.evening);
  const needsAnyNotes = !(hasMorningDoc && hasEveningDoc);

  Logger.log(
    'NOW=' + Utilities.formatDate(now, CONFIG.TIMEZONE, 'yyyy-MM-dd EEE') +
    '  nextSunday=' + Utilities.formatDate(nextSunday, CONFIG.TIMEZONE, 'yyyy-MM-dd EEE') +
    '  weekNum=' + weekNum
  );

  let sermonFormatted = null;
  if (needsAnyNotes) {
    const sermonBody = getSermonTextForDate_(nextSunday);
    sermonFormatted = sermonBody ? formatSermonForEmail_(sermonBody) : null;
  }

  const NOTES_BY_SERVICE = {
    morning: {
      text: (!hasMorningDoc && sermonFormatted && sermonFormatted.text)
        ? `\nNotes for this Sunday:\n${sermonFormatted.text}\n`
        : '',
      html: (!hasMorningDoc && sermonFormatted && sermonFormatted.html)
        ? sermonFormatted.html
        : ''
    },
    evening: {
      text: (!hasEveningDoc && sermonFormatted && sermonFormatted.text)
        ? `\nNotes for this Sunday:\n${sermonFormatted.text}\n`
        : '',
      html: (!hasEveningDoc && sermonFormatted && sermonFormatted.html)
        ? sermonFormatted.html
        : ''
    }
  };

  const guest = getGuestPreacherInfoForDate_(nextSunday); // { name, email }

  // Service Leader email (morning)
  sendServiceLeaderEmailForDate_(
    nextSunday,
    serviceDocx,
    hasMorningDoc,
    NOTES_BY_SERVICE.morning.text,
    NOTES_BY_SERVICE.morning.html
  );

  // Evening preacher reminders
  sendEveningPreacherEmailForDate_(nextSunday);

  const twoWeeksOut = new Date(now.getTime());
  twoWeeksOut.setDate(twoWeeksOut.getDate() + 14);
  const twoWeeksOutSunday = getNextSunday_(twoWeeksOut);
  sendEveningPreacherEmailForDate_(twoWeeksOutSunday);

  if (!sched) return;

  const volunteersMap = getVolunteersById_();
  const headers = getHeaders_(scheduleSheet);
  const assignments = buildAssignmentsForRow_(sched, headers);

  // Backups
  const backupCounterId   = String(assignments.backups.counterId || '').trim();
  const backupAVId        = String(assignments.backups.avId || '').trim();
  const backupCounterName = lookupFirstName_(volunteersMap, backupCounterId);
  const backupAVName      = lookupFirstName_(volunteersMap, backupAVId);

  const backupCounterContact =
    (typeof formatBackupContact_ === 'function') ? formatBackupContact_(volunteersMap, backupCounterId) : '';
  const backupAVContact =
    (typeof formatBackupContact_ === 'function') ? formatBackupContact_(volunteersMap, backupAVId) : '';

  const PRIMARY_LABELS = {
    counting: 'counter',
    music: 'morning musician',
    av: 'AV engineer'
  };

  const SPECIAL_LABELS = {
    morningLead:  'morning service leader',
    eveningLead:  'evening service leader',
    eveningMusic: 'evening music leader',
    eveningPreach:'evening preacher',
    guestPreach:  'guest preacher'
  };

  const dateMMDD = Utilities.formatDate(nextSunday, tz, 'MM/dd');
  const subjectCommon = `This Sunday ${dateMMDD}: you’re serving`;

  const namesFromIds = (ids) => ids
    .map(id => String(id || '').trim())
    .filter(Boolean)
    .map(id => (volunteersMap[id]?.FirstName || '').trim())
    .filter(Boolean);

  const teamCounting = namesFromIds(assignments.roles.counting).join(', ');
  const teamMusic    = namesFromIds(assignments.roles.music).join(', ');
  const teamAV       = namesFromIds(assignments.roles.av).join(', ');

  const messagesByVolunteer = {};

  function ensureVol(id) {
    const key = String(id || '').trim();
    if (!key) return null;
    const p = volunteersMap[key];
    if (!p || !p.Email) return null;

    if (!messagesByVolunteer[key]) {
      messagesByVolunteer[key] = {
        id: key,
        email: p.Email,
        firstName: p.FirstName || '',
        roles: new Set(),

        // primary flags
        isCounter: false,
        isAV: false,
        isMorningMusician: false,

        // backup flags
        isCounterBackup: false,
        isAVBackup: false,

        // special flags
        isMorningLead: false,
        isEveningLead: false,
        isEveningMusic: false,
        isEveningPreach: false,
        isGuestPreach: false
      };
    }
    return messagesByVolunteer[key];
  }

  // Primaries
  for (const [roleKey, ids] of Object.entries(assignments.roles)) {
    const label = PRIMARY_LABELS[roleKey];
    ids.forEach(id => {
      const m = ensureVol(id);
      if (!m) return;
      m.roles.add(label);
      if (roleKey === 'counting') m.isCounter = true;
      if (roleKey === 'av') m.isAV = true;
      if (roleKey === 'music') m.isMorningMusician = true;
    });
  }

  // Specials
  const sp = assignments.specials || {};
  [
    ['morningLead','isMorningLead'],
    ['eveningLead','isEveningLead'],
    ['eveningMusic','isEveningMusic'],
    ['eveningPreach','isEveningPreach'],
    ['guestPreach','isGuestPreach']
  ].forEach(([field, flag]) => {
    const id = sp[field];
    const m = ensureVol(id);
    if (!m) return;
    m.roles.add(SPECIAL_LABELS[field]);
    m[flag] = true;
  });

  // Backups
  if (backupCounterId) {
    const m = ensureVol(backupCounterId);
    if (m) m.isCounterBackup = true;
  }
  if (backupAVId) {
    const m = ensureVol(backupAVId);
    if (m) m.isAVBackup = true;
  }

  Object.values(messagesByVolunteer).forEach(msg => {
    const serviceProfile = getVolunteerServiceProfile_(msg);

    // backup-only email
    if (msg.roles.size === 0) {
      const which = englishJoin_([
        msg.isCounterBackup ? 'backup counter' : '',
        msg.isAVBackup ? 'backup AV engineer' : ''
      ].filter(Boolean));
      if (!which) return;

      let body = '';
      body += `Hey ${msg.firstName},\n`;
      body += `You are receiving this email because you are designated as the ${which} for this week.\n`;

      const notesText = buildNotesTextForVolunteer_(serviceProfile, NOTES_BY_SERVICE);
      if (notesText) body += notesText + '\n';

      body += `Thank you for volunteering! Your help is much appreciated.\n\n`;
      body += `Sincerely,\n${CONFIG.FROM_NAME}\n`;

      let htmlBody = escapeHtml_(body).replace(/\n/g, '<br>');
      const notesHtml = buildNotesHtmlForVolunteer_(serviceProfile, NOTES_BY_SERVICE);
      if (notesHtml) {
        htmlBody = buildHtmlBodyWithoutDuplicateNotes_(body, notesHtml);
      }

      const attachments = getAttachmentsForVolunteer_(serviceDocx, serviceProfile);
      const mailOpts = {
        name: CONFIG.FROM_NAME,
        htmlBody: htmlBody
      };
      if (attachments.length) mailOpts.attachments = attachments;

      if (CONFIG.TEST_MODE) {
        GmailApp.sendEmail(
          Session.getActiveUser().getEmail(),
          'TEST: ' + subjectCommon,
          body,
          mailOpts
        );
      } else {
        GmailApp.sendEmail(msg.email, subjectCommon, body, mailOpts);
      }
      return;
    }

    const rolesPhrase = englishJoin_(Array.from(msg.roles));
    let body = '';
    body += `Hey ${msg.firstName},\n\n`;
    body += `A friendly reminder that you are serving as a ${rolesPhrase} for this coming Sunday, ${dateMMDD}.\n\n`;

    if (msg.isCounter && teamCounting) {
      body += `Your counting team this week is: ${teamCounting}\n\n`;
    }
    if (msg.isMorningMusician && teamMusic) {
      body += `Please note that we added a song between the giving prayer and the prayer of petition! Remain on stage until the pastoral prayer. Your music team this week is: ${teamMusic}\n\n`;
    }
    if (msg.isAV && teamAV) {
      body += `Your AV team this week is: ${teamAV}\n\n`;
    }

    if (msg.isCounter && backupCounterName) {
      body += `Your backup counter is ${backupCounterName}${backupCounterContact ? ' ' + backupCounterContact : ''}. Please text or call them if you are unable to serve this week!\n\n`;
    }
    if (msg.isAV && backupAVName) {
      body += `Your backup AV engineer is ${backupAVName}${backupAVContact ? ' ' + backupAVContact : ''}. Please text or call them if you are unable to serve this week!\n\n`;
    }

    const extraBackups = [];
    if (msg.isCounterBackup) extraBackups.push('backup counter');
    if (msg.isAVBackup) extraBackups.push('backup AV engineer');
    if (extraBackups.length) {
      body += `Additionally, you are designated as the ${englishJoin_(extraBackups)} for this week.\n\n`;
    }

    const MORNING_TEMPLATE = 'https://docs.google.com/document/d/1HlALA0RZAwQauQmUpXTHtjUyhAIVNOmhgcKvZhWzS4s/edit?usp=sharing';
    if (msg.isMorningLead) {
      body += `Here is a link to the morning service leading template: ${MORNING_TEMPLATE}\n\n`;
    }
    if (msg.isEveningMusic) {
      body += `Evening music: please come early enough to practice and sound check! feel free to ask other musicians if they would like to join you.\n\n`;
    }
    if (msg.isEveningPreach) {
      body += `Evening preaching: thank you for sharing the word this evening.\n\n`;
    }
    if (msg.isGuestPreach) {
      body += `We're excited to hear God's word through you this coming Sunday! Guest preaching details: We typically have the guest speaker come up after the time of giving and lead us in a pastoral prayer, followed by the sermon, followed by a final song. After the song, please share a benediction to conclude the gathering.\n\n`;
    }

    const notesText = buildNotesTextForVolunteer_(serviceProfile, NOTES_BY_SERVICE);
    if (notesText) {
      body += notesText + '\n';
    }

    body += `Thank you for volunteering! Your help is much appreciated.\n\n`;
    body += `Sincerely,\n${CONFIG.FROM_NAME}\n`;

    const notesHtml = buildNotesHtmlForVolunteer_(serviceProfile, NOTES_BY_SERVICE);
    let htmlBody = notesHtml
      ? buildHtmlBodyWithoutDuplicateNotes_(body, notesHtml)
      : escapeHtml_(body).replace(/\n/g, '<br>');

    const attachments = getAttachmentsForVolunteer_(serviceDocx, serviceProfile);
    const sendOpts = {
      name: CONFIG.FROM_NAME,
      htmlBody: htmlBody
    };
    if (attachments.length) sendOpts.attachments = attachments;

    if (CONFIG.TEST_MODE) {
      GmailApp.sendEmail(
        Session.getActiveUser().getEmail(),
        'TEST: ' + subjectCommon,
        body,
        sendOpts
      );
    } else {
      GmailApp.sendEmail(msg.email, subjectCommon, body, sendOpts);
    }
  });

  // Guest preacher email (morning service)
  if (guest.email) {
    const gFirst = firstName_(guest.name);
    const subjectGuest = `This Sunday ${dateMMDD}: guest preaching`;

    const gDoc = (serviceDocx && serviceDocx.morning) ? serviceDocx.morning : null;

    let gBody = '';
    gBody += (gFirst ? `Hey ${gFirst},\n\n` : 'Hello,\n\n');
    gBody += `Thank you for bringing God's word to First Baptist Church of Artesia this coming Sunday, ${dateMMDD}. `;
    gBody += `In case John is absent, we typically have the guest speaker come up after the time of giving and lead us in a pastoral prayer, followed by the sermon, followed by a final song. `;
    gBody += `After the song, please share a benediction to conclude the gathering.\n\n`;
    gBody += `Please clarify with John if there is any confusion!\n\n`;

    if (NOTES_BY_SERVICE.morning.text) {
      gBody += NOTES_BY_SERVICE.morning.text + '\n';
    }

    gBody += `Thanks again!\n\n`;
    gBody += `Sincerely,\n${CONFIG.FROM_NAME}\n`;

    let gHtmlBody = NOTES_BY_SERVICE.morning.html
      ? buildHtmlBodyWithoutDuplicateNotes_(gBody, NOTES_BY_SERVICE.morning.html)
      : escapeHtml_(gBody).replace(/\n/g, '<br>');

    const gOpts = { name: CONFIG.FROM_NAME, htmlBody: gHtmlBody };
    if (gDoc) gOpts.attachments = [gDoc];

    if (CONFIG.TEST_MODE) {
      GmailApp.sendEmail(
        Session.getActiveUser().getEmail(),
        'TEST: ' + subjectGuest,
        gBody,
        gOpts
      );
    } else {
      GmailApp.sendEmail(guest.email, subjectGuest, gBody, gOpts);
    }
  }
}

function sendMonthlyReminders() {
  const tz = CONFIG.TIMEZONE;
  const now = new Date();
  const startMonth0 = now.getMonth();        // 0..11
  const startYear   = now.getFullYear();

  // Current month + next month
  const months = [
    { y: startYear, m: startMonth0 },
    { y: startYear + Math.floor((startMonth0 + 1) / 12), m: (startMonth0 + 1) % 12 }
  ];
  const sundays = [];
  months.forEach(({y, m}) => sundays.push(...allSundaysInMonth_(y, m)));
  if (sundays.length === 0) return;

  const volunteersMap = getVolunteersById_();

  // id => {email, firstName, dates:[{date, roles:Set, isCounterBackup, isAVBackup}]}
  const perVolunteer = {};

  function ensureSlot(id, d) {
    const key = String(id || '').trim();
    if (!key) return null;
    const p = volunteersMap[key];
    if (!p || !p.Email) return null;
    if (!perVolunteer[key]) {
      perVolunteer[key] = { email: p.Email, firstName: p.FirstName || '', dates: [] };
    }
    let slot = perVolunteer[key].dates.find(x => sameDate_(x.date, d));
    if (!slot) {
      slot = { date: new Date(d), roles: new Set(), isCounterBackup: false, isAVBackup: false };
      perVolunteer[key].dates.push(slot);
    }
    return slot;
  }

  // Collect assignments for every Sunday in the two-month window
  for (const d of sundays) {
    const sheetForYear = getScheduleSheetByYear_(d.getFullYear());
    const headers = getHeaders_(sheetForYear);
    const weekNum = weekNumberSundayStart_(d);
    const sched = readScheduleRowByWeek_(sheetForYear, weekNum);
    if (!sched) continue;

    const assignments = buildAssignmentsForRow_(sched, headers);

    // Primary roles
    (assignments.roles?.counting || []).forEach(id => {
      const slot = ensureSlot(id, d); if (slot) slot.roles.add('counter');
    });
    (assignments.roles?.music || []).forEach(id => {
      const slot = ensureSlot(id, d); if (slot) slot.roles.add('morning musician');
    });
    (assignments.roles?.av || []).forEach(id => {
      const slot = ensureSlot(id, d); if (slot) slot.roles.add('AV engineer');
    });

    // NEW: special roles (single ID each)
    const sp = assignments.specials || {};
    [
      [sp.morningLead,  'morning service leader'],
      [sp.eveningLead,  'evening service leader'],
      [sp.eveningMusic, 'evening music leader'],
      [sp.eveningPreach,'evening preacher'],
      [sp.guestPreach,  'guest preacher']
    ].forEach(([id, label]) => {
      const slot = ensureSlot(id, d); if (slot) slot.roles.add(label);
    });

    // Backups (flags only; listed in their own section)
    const cb = String(assignments.backups?.counterId || '').trim();
    const ab = String(assignments.backups?.avId || '').trim();
    if (cb) { const slot = ensureSlot(cb, d); if (slot) slot.isCounterBackup = true; }
    if (ab) { const slot = ensureSlot(ab, d); if (slot) slot.isAVBackup = true; }
  }

  // Subject range label
  const rangeLabel = (() => {
    const d1 = new Date(months[0].y, months[0].m, 1);
    const d2 = new Date(months[1].y, months[1].m, 1);
    const sameYear = d1.getFullYear() === d2.getFullYear();
    const m1 = Utilities.formatDate(d1, tz, 'MMMM');
    const m2 = Utilities.formatDate(d2, tz, 'MMMM');
    return sameYear ? `${m1}–${m2} ${d1.getFullYear()}`
                    : `${m1} ${d1.getFullYear()}–${m2} ${d2.getFullYear()}`;
  })();

  // Send emails
  Object.entries(perVolunteer).forEach(([id, rec]) => {
    // Aggregate overall roles (across dates) for the intro sentence
    const rolesSet = new Set();
    rec.dates.forEach(s => s.roles.forEach(r => rolesSet.add(r)));
    const rolesPhrase = englishJoin_(Array.from(rolesSet));

    // Lines: "Month d, yyyy (role, role)"
    const primaryLines = rec.dates
      .filter(s => s.roles.size > 0)
      .sort((a, b) => a.date - b.date)
      .map(s => {
        const label = Utilities.formatDate(s.date, tz, 'MMMM d, yyyy');
        const roleList = englishJoin_(Array.from(s.roles));
        return `- ${label} (${roleList})`;
      })
      .join('\n');

    // Backup sections
    const counterBackupDates = rec.dates
      .filter(s => s.isCounterBackup)
      .sort((a, b) => a.date - b.date)
      .map(s => `- ${Utilities.formatDate(s.date, tz, 'MMMM d, yyyy')}`)
      .join('\n');

    const avBackupDates = rec.dates
      .filter(s => s.isAVBackup)
      .sort((a, b) => a.date - b.date)
      .map(s => `- ${Utilities.formatDate(s.date, tz, 'MMMM d, yyyy')}`)
      .join('\n');

    if (rolesSet.size === 0 && !counterBackupDates && !avBackupDates) {
      // nothing for this person in the window
      return;
    }

    let body = '';
    
    body += `Hey ${rec.firstName},\n`;

    if (rolesSet.size > 0) {
      body += `You are receiving this email because you are serving as: ${rolesPhrase} for the following weeks in the next two months:\n \n`;
      body += `${primaryLines}\n`;
    }

    if (counterBackupDates || avBackupDates) {
      if (rolesSet.size > 0) body += `\n`;
      body += `Backup assignments in the next two months:\n`;
      if (counterBackupDates) body += `Back up counter:\n${counterBackupDates}\n`;
      if (avBackupDates) body += `Back up AV engineer:\n${avBackupDates}\n`;
    }

    body += `\nThank you for volunteering! Your help is much appreciated.\n\n`;
    body += `Sincerely,\n${CONFIG.FROM_NAME}\n`;

    const subject = `Your volunteer dates for the next two months (${rangeLabel})`;
    if (CONFIG.TEST_MODE) {
      // Redirect all emails to yourself
      GmailApp.sendEmail(
        Session.getActiveUser().getEmail(),
        'TEST: ' + subject,
        body
      );
    } 
    else {
      GmailApp.sendEmail(rec.email, subject, body);
    }
    return;
  });
}

function sendGuestPreacherMonthlyReminders() {
  if (!NOTION.ENABLED) return;

  const tz = CONFIG.TIMEZONE;
  const now = new Date();
  const startMonth0 = now.getMonth();
  const startYear   = now.getFullYear();

  // Build current + next month Sundays
  const months = [
    { y: startYear,                           m: startMonth0 },
    { y: startYear + Math.floor((startMonth0 + 1) / 12), m: (startMonth0 + 1) % 12 }
  ];
  const sundays = [];
  months.forEach(({y, m}) => sundays.push(...allSundaysInMonth_(y, m)));
  if (!sundays.length) return;

  // Label for subject
  const rangeLabel = (() => {
    const d1 = new Date(months[0].y, months[0].m, 1);
    const d2 = new Date(months[1].y, months[1].m, 1);
    const sameYear = d1.getFullYear() === d2.getFullYear();
    const m1 = Utilities.formatDate(d1, tz, 'MMMM');
    const m2 = Utilities.formatDate(d2, tz, 'MMMM');
    return sameYear ? `${m1}–${m2} ${d1.getFullYear()}` : `${m1} ${d1.getFullYear()}–${m2} ${d2.getFullYear()}`;
  })();

  // Collect dates per guest email
  const perGuest = {}; // email(lower) => { name, email, dates: [Date] }

  for (const d of sundays) {
    const iso = Utilities.formatDate(d, 'UTC', 'yyyy-MM-dd');
    const rows = queryRowsByDate_(iso); // your existing Notion DB query
    if (!rows || !rows.length) continue;

    rows.forEach(row => {
      const props = row.properties || {};
      const name  = notionPropToString_(props[NOTION.PREACHER_NAME_PROP]);
      const email = notionPropToString_(props[NOTION.GUEST_EMAIL_PROP]);
      if (!email) return;
      const key = email.toLowerCase();
      if (!perGuest[key]) perGuest[key] = { name: name || '', email, dates: [] };
      perGuest[key].dates.push(new Date(d));
    });
  }

  // Send one email per guest with all dates
  Object.values(perGuest).forEach(g => {
    if (!g.dates.length) return;

