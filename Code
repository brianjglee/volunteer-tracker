/**
 * Try to find a volunteer by matching full name against volunteers sheet.
 * Match rules:
 * - case-insensitive
 * - ignores extra spaces
 * - compares "First Last" and also allows "Last, First"
 */
function findVolunteerByFullName_(volunteersMap, fullName) {
  const target = String(fullName || '').trim();
  if (!target) return null;

  const norm = (s) => String(s || '')
    .toLowerCase()
    .replace(/[.\u2019']/g, '')   // remove periods/apostrophes
    .replace(/\s+/g, ' ')
    .trim();

  const t = norm(target);

  // Split target into parts for simple rearrange matching
  // (handles "Last, First" too)
  let tFirstLast = t;
  if (t.includes(',')) {
    const parts = t.split(',').map(x => x.trim()).filter(Boolean);
    if (parts.length >= 2) tFirstLast = norm(parts.slice(1).join(' ') + ' ' + parts[0]);
  }

  for (const [id, v] of Object.entries(volunteersMap)) {
    const first = norm(v.FirstName);
    const last  = norm(v.LastName);
    const fl = norm(`${first} ${last}`);
    if (!fl) continue;

    if (fl === t || fl === tFirstLast) {
      return { id, ...v };
    }
  }

  return null;
}

