// Turn a Notion property value into a string (handles common types)
function notionPropToString_(prop) {
  if (!prop || !prop.type) return '';
  switch (prop.type) {
    case 'title':
    case 'rich_text':
      return (prop[prop.type] || []).map(r => r.plain_text || '').join('').trim();
    case 'email':
      return String(prop.email || '').trim();
    case 'people':
      return (prop.people || []).map(p => p.name || '').filter(Boolean).join(', ');
    case 'select':
      return (prop.select && prop.select.name) ? prop.select.name : '';
    case 'multi_select':
      return (prop.multi_select || []).map(s => s.name || '').filter(Boolean).join(', ');
    case 'url':
      return String(prop.url || '').trim();
    case 'formula':
      if (!prop.formula) return '';
      // common formula result types
      if (prop.formula.type === 'string') return String(prop.formula.string || '').trim();
      if (prop.formula.type === 'number') return String(prop.formula.number ?? '').trim();
