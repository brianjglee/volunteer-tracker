}

function fetchNotionPageText_(pageId, maxChars) {
  if (!pageId) return '';
  const text = fetchBlockRecursive_(pageId, 0).join('\n');
  if (maxChars && text.length > maxChars)
    return text.slice(0, maxChars) + '…';
  return text;
}

function fetchBlockRecursive_(blockId, indentLevel) {
  const url = `https://api.notion.com/v1/blocks/${blockId}/children?page_size=100`;
  const resp = UrlFetchApp.fetch(url, { headers: notionHeaders_(), muteHttpExceptions: true });
  if (resp.getResponseCode() !== 200) return [];

  const json = JSON.parse(resp.getContentText());
  let lines = [];

  json.results.forEach(block => {
    const text = extractBlockTextRecursive_(block, indentLevel);
    if (text) lines.push(text);

    if (block.has_children) {
      const childLines = fetchBlockRecursive_(block.id, indentLevel + 2);
      lines = lines.concat(childLines);
    }
  });

  return lines;
}

function extractBlockTextRecursive_(block, indentLevel) {
  const type = block.type;
  const body = block[type];
  if (!body) return '';

  if (type === 'code') return '';

  const rich = (body.rich_text || [])
      .map(r => r.plain_text || '')
      .join('')
      .trim();

  if (!rich) return '';

  const indent = '       '.repeat(indentLevel);

  switch (type) {
    case 'heading_1': return indent + rich.toUpperCase();
    case 'heading_2':
    case 'heading_3':
    case 'paragraph': return indent + rich;
    case 'bulleted_list_item': return indent + '• ' + rich;
    case 'numbered_list_item': return indent + rich; // already "1. ", "2. " etc.
    case 'quote': return indent + '"' + rich + '"';
    case 'callout': return indent + rich;
    case 'to_do': return indent + (body.checked ? '[x] ' : '[ ] ') + rich;
    default: return indent + rich;
  }
}

// For 2025-09-03 only: discover data_source_id for a database id (cached)
function getDataSourceIdForDb_(dbId) {
  if (NOTION.API_VERSION !== '2025-09-03') return ''; // not needed on older API
  const props = PropertiesService.getScriptProperties();
  const cacheKey = 'DS_FOR_' + dbId;
  const cached = props.getProperty(cacheKey);
  if (cached) return cached;

  const resp = UrlFetchApp.fetch(`https://api.notion.com/v1/databases/${dbId.replace(/-/g,'')}`, {
    headers: notionHeaders_(), muteHttpExceptions: true
  });
  if (resp.getResponseCode() !== 200) throw new Error('GET database failed: ' + resp.getContentText());
  const json = JSON.parse(resp.getContentText());
  const list = json.data_sources || [];
  if (!list.length) throw new Error('No data_sources on this database.');
  const chosen = NOTION.DATA_SOURCE_NAME
    ? (list.find(d => d.name === NOTION.DATA_SOURCE_NAME) || list[0])
    : list[0];
  props.setProperty(cacheKey, chosen.id);
  return chosen.id;
}

